# Copy to .env and fill in. Never commit .env. On Railway, set these as service variables.
ANTHROPIC_API_KEY=
# Optional overrides
SIKHNET_MODEL=claude-opus-5
# Answer quality vs latency: low | medium | high | xhigh | max
SIKHNET_EFFORT=high
SIKHNET_DATA=data/processed/qa.jsonl

# Community features (decision 006)
# Required when deployed: the moderator page is locked without it.
SIKHNET_ADMIN_TOKEN=
# SQLite file for posts/votes (default data/community/community.db; on Railway the volume).
# SIKHNET_DB=
# Set to 0 to turn off the background Claude moderation check.
# SIKHNET_AI_MODERATION=1

# Deploy only (docs/DEPLOY.md): private, expiring link to the raw dataset export.
# SIKHNET_DATA_URL=
# SIKHNET_DATA_TOKEN=
# SIKHNET_DATA_FORMAT=jsonl
# SIKHNET_REINGEST=0
